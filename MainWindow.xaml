<Window x:Class="BluetoothAudioBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Audio Bridge" Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}">
  <StackPanel Margin="24,22,24,22">
    <Path x:Name="TitlePath" Stroke="{DynamicResource Outline}" StrokeThickness="1" HorizontalAlignment="Left"
          StrokeLineJoin="Round"/>
    <TextBlock Text="Play your phone's audio on this PC, as a regular Windows app."
               Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/>

    <Grid>
      <!-- thin offset line under the card + soft neutral shadow -->
      <Border CornerRadius="10" Margin="0,2,0,-2" BorderBrush="{DynamicResource Border}" BorderThickness="1"
              Background="{DynamicResource Card}"/>
      <Border CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" Padding="18">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="↻" Click="Refresh_Click"
                    ToolTip="Refresh" AutomationProperties.Name="Refresh devices"/>
            <TextBlock Text="PAIRED PHONES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center"/>
          </DockPanel>

          <ListBox x:Name="Devices" Margin="0,10,0,0" MaxHeight="120" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource DeviceItem}" AutomationProperties.Name="Paired phones"/>

          <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="No paired phone yet. Pair it once in Windows, then come back and refresh."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13"/>
            <Button Style="{StaticResource IconButton}" Content="Open Bluetooth settings" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="Bluetooth_Click"/>
          </StackPanel>

          <Grid Width="176" Height="176" Margin="0,18,0,8">
            <Ellipse Margin="6" Stroke="{DynamicResource Border}" StrokeThickness="8"/>
            <Path x:Name="LevelArc" Stroke="{DynamicResource Orange}" StrokeThickness="8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Button x:Name="Toggle" Style="{StaticResource PowerButton}" Width="128" Height="128" Click="Toggle_Click"
                    AutomationProperties.Name="Connect or disconnect">
              <TextBlock x:Name="ToggleText" Text="Connect" FontSize="17" FontWeight="Bold"/>
            </Button>
          </Grid>

          <Border CornerRadius="14" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,6"
                  HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Button Style="{StaticResource IconButton}" Content="Open Windows volume mixer" Margin="0,18,0,0"
            Click="Mixer_Click"/>
  </StackPanel>
</Window>

<Window x:Class="BluetoothAudioBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Audio Bridge" Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}">
  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="Bluetooth Audio Bridge" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Receive your phone's audio on this PC" Foreground="{DynamicResource Muted}" FontSize="13"
               Margin="0,2,0,16"/>

    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="8">
      <StackPanel>
        <DockPanel Margin="8,4,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Padding="8,3" Click="Refresh_Click"
                  ToolTip="Refresh" AutomationProperties.Name="Refresh devices">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
          </Button>
          <TextBlock Text="Paired phones" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="Devices" MaxHeight="130" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource DeviceItem}" AutomationProperties.Name="Paired phones"/>
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="8,4,8,8">
          <TextBlock Text="No paired phone yet. Pair it once in Windows, then refresh." TextWrapping="Wrap"
                     Foreground="{DynamicResource Muted}" FontSize="13"/>
          <Button Style="{StaticResource PlainButton}" Content="Open Bluetooth settings" Margin="0,10,0,0"
                  HorizontalAlignment="Left" Click="Bluetooth_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
      <DockPanel>
        <ToggleButton x:Name="Toggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Toggle_Click"
                      VerticalAlignment="Center" AutomationProperties.Name="Connection"/>
        <StackPanel>
          <TextBlock Text="Connection" FontSize="14"/>
          <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="12" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" Margin="0,2,16,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="Sound output" FontSize="14"/>
        <TextBlock Text="Where the phone's audio plays on this PC." FontSize="12" Foreground="{DynamicResource Muted}"
                   Margin="0,2,0,10"/>
        <Button x:Name="OutBtn" Style="{StaticResource PlainButton}" Click="OutBtn_Click"
                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Sound output device">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBlock x:Name="OutName" Text="System default" FontSize="13" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left"/>
          </DockPanel>
        </Button>
        <Popup x:Name="OutPopup" PlacementTarget="{Binding ElementName=OutBtn}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=OutBtn}">
          <Border CornerRadius="6" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" Margin="0,4,0,0" Padding="2">
            <ListBox x:Name="Outputs" MaxHeight="200" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource OutputItem}" SelectionChanged="Outputs_SelectionChanged"
                     AutomationProperties.Name="Output devices"/>
          </Border>
        </Popup>
      </StackPanel>
    </Border>

    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
      <DockPanel>
        <ToggleButton x:Name="Startup" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click"
                      VerticalAlignment="Center" AutomationProperties.Name="Start with Windows"/>
        <StackPanel>
          <TextBlock Text="Start with Windows" FontSize="14"/>
          <TextBlock Text="Opens minimized and reconnects your phone automatically." FontSize="12"
                     Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,16,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="Audio level" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
        <ProgressBar x:Name="Level" Height="4" Maximum="1" BorderThickness="0"
                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}"
                     AutomationProperties.Name="Audio level"/>
      </StackPanel>
    </Border>

    <Button Style="{StaticResource PlainButton}" Content="Open Windows volume mixer" Margin="0,16,0,0"
            HorizontalAlignment="Left" Click="Mixer_Click"/>
  </StackPanel>
</Window>
